# Everything Unity generates. Only Assets/Editor, Packages/manifest.json and ProjectVersion.txt are source; the preview's
# copies of the kit (Assets/Preview) are put there by RealLifeOverhaul.Build/UiPreview/preview.ps1 for each run.
/Library/
/Temp/
/Logs/
/UserSettings/
/obj/
/BundleOutput/
/Assets/Generated/
/Assets/Generated.meta
/Assets/Preview/
/Assets/Preview.meta
/Assets/TextMesh Pro/
/Assets/TextMesh Pro.meta
/Assets/*.meta
/Assets/Editor/*.meta
/Packages/packages-lock.json
/ProjectSettings/*
!/ProjectSettings/ProjectVersion.txt
*.csproj
*.sln
