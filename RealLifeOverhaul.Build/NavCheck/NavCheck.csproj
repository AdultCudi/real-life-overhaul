<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the minimap's and the GPS's game-free parts outside the game: the search done whole and in slices, routes
       on a made-up grid of streets, turns, leaving the route and arriving, the view's arithmetic and the map picture.
       Compiles the mod's own files, so it checks exactly what ships. It also checks the bus bays (BayCheck.cs with
       Transport\BusBay.cs): where a bus stands, the curves in and out, and a model bus driven along them. And the taxi called from the
       phone (TaxiCheck.cs with Transport\Taxi\TaxiRules.cs): its charges, its bands, its refusals, and its search. And the rules of the live street
       (StreetCheck.cs with Traffic\Reckless\StreetRules.cs): the horn, the reckless drivers, how often, and what comes of it. And the minimap's
       buildings and water (BaseCheck.cs with Navigation\NavBaseRules.cs): a place on the picture and back, the window at the city's edges,
       outlines, the water grid, the drawing and the kept file. And three small rules
       of the interface and the camera (PolishCheck.cs with Core\GameUi\PanelPlacement.cs, Core\GameUi\BarRule.cs, Camera\CameraWatch.cs and
       Core\OtherModName.cs): where a panel stands beside the game's building box, when a bar is written again, and when the camera
       stands down for another mod's. And the arithmetic of the hair finish (HairCheck.cs with Character\HairRules.cs): how bright hair
       can get under a light by the shader's own formulas, the bounds on its back-light and highlight, and how solid its strands are.
       Run: dotnet run -c Release (from this folder).
       Exit code 0 = all checks passed. With the path of a file of lane points as its argument it also times the search
       and the picture on that city (see the README, "Minimap and GPS"). -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RealLifeOverhaul</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Core\RouteSearch.cs" Link="Mod\RouteSearch.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Navigation\NavModel.cs" Link="Mod\NavModel.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Navigation\NavBaseRules.cs" Link="Mod\NavBaseRules.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Transport\BusBay.cs" Link="Mod\BusBay.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Transport\Taxi\TaxiRules.cs" Link="Mod\TaxiRules.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Traffic\Reckless\StreetRules.cs" Link="Mod\StreetRules.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Core\GameUi\PanelPlacement.cs" Link="Mod\PanelPlacement.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Core\GameUi\BarRule.cs" Link="Mod\BarRule.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Camera\CameraWatch.cs" Link="Mod\CameraWatch.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Core\OtherModName.cs" Link="Mod\OtherModName.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Character\HairRules.cs" Link="Mod\HairRules.cs" />
  </ItemGroup>

</Project>
