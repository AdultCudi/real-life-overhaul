<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the rules of docs/standards that a program can check, by reading the repository's files as text: the code
       style, the architecture's boundaries, the per-frame rules, Going Public safety, the offline checks' coverage, the
       texts and the branch and its commits. It compiles none of the mod's sources. What the code held when the standard
       was set is listed in baseline.txt, so that only new breaks fail. Run: dotnet run -c Release (from this folder),
       or dotnet bin/Release/net10.0/StandardCheck.dll [repository root] [-write-baseline]. Exit code 0 = all checks passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RealLifeOverhaul</RootNamespace>
  </PropertyGroup>

</Project>
