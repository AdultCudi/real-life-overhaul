<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway verifier for the RealLifeOverhaul life event catalogue. Compiles the mod's
       game-free catalogue sources directly, so it checks exactly what ships.
       Run: dotnet run -c Release (from this folder). Exit code 0 = all checks passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RealLifeOverhaul</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Life\LifeEventCatalogue*.cs" Link="Mod\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Life\LifeEventDeck.cs" Link="Mod\LifeEventDeck.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Crime\CrimeDeck.cs" Link="Mod\CrimeDeck.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Crime\CrimeCatalogue.cs" Link="Mod\CrimeCatalogue.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Jobs\JobCatalogue.cs" Link="Mod\JobCatalogue.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Jobs\CareerCatalogue.cs" Link="Mod\CareerCatalogue.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Jobs\GigOffers.cs" Link="Mod\GigOffers.cs" />
  </ItemGroup>

</Project>
