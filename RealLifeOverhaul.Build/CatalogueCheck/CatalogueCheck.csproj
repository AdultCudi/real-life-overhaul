<Project Sdk="Microsoft.NET.Sdk">

  <!-- Throwaway verifier for the RealLifeOverhaul life event catalogue. Compiles the mod's
       game-free catalogue sources directly, so it checks exactly what ships.
       Run: dotnet run -c Release (from this folder). Exit code 0 = all checks passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RealLifeOverhaul</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Life\LifeEventCatalogue*.cs" Link="Mod\%(Filename)%(Extension)" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Life\LifeEventDeck.cs" Link="Mod\LifeEventDeck.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Crime\CrimeDeck.cs" Link="Mod\CrimeDeck.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Crime\CrimeCatalogue.cs" Link="Mod\CrimeCatalogue.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Core\Prices.cs" Link="Mod\Prices.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Jobs\JobCatalogue.cs" Link="Mod\JobCatalogue.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Jobs\CareerCatalogue.cs" Link="Mod\CareerCatalogue.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Jobs\CareerOfficeRules.cs" Link="Mod\CareerOfficeRules.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Jobs\GigOffers.cs" Link="Mod\GigOffers.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Jobs\PaySlip.cs" Link="Mod\PaySlip.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Jobs\JobSave.cs" Link="Mod\JobSave.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Meta\OptionsTree.cs" Link="Mod\OptionsTree.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Meta\OptionsPlan.cs" Link="Mod\OptionsPlan.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Meta\SettingsRules.cs" Link="Mod\SettingsRules.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Phone\Contacts\ContactCatalogue.cs" Link="Mod\ContactCatalogue.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Phone\Contacts\ContactGroups.cs" Link="Mod\ContactGroups.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\People\PersonLook.cs" Link="Mod\PersonLook.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Core\GameUi\NoticeKinds.cs" Link="Mod\NoticeKinds.cs" />
    <Compile Include="..\Shared\ModLanguages.cs" Link="Shared\ModLanguages.cs" />
  </ItemGroup>

</Project>
