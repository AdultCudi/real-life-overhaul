<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the economy's game-free parts outside the game: the credit rating's arithmetic, the lending terms and the
       phone's fee, the credit file's cap and folding, its line in the save across versions, how the game's loans
       are told apart, and (Checks2.cs) the credit products, what happens when payments are missed, consolidation,
       the lender of last resort and the ways out of debt, and (VenturesChecks.cs) investors, the pitch, deals and the
       stock market. Compiles the mod's own files, so it checks exactly what ships.
       Run: dotnet run -c Release (from this folder). Exit code 0 = all checks passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RealLifeOverhaul</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\CreditCatalogue.cs" Link="Mod\CreditCatalogue.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\CreditModel.cs" Link="Mod\CreditModel.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\CreditScoring.cs" Link="Mod\CreditScoring.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\CreditStore.cs" Link="Mod\CreditStore.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\CreditLedger.cs" Link="Mod\CreditLedger.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\LoanBook.cs" Link="Mod\LoanBook.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Lending\LendingTerms.cs" Link="Mod\LendingTerms.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Products\ProductCatalogue.cs" Link="Mod\ProductCatalogue.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Products\ProductTerms.cs" Link="Mod\ProductTerms.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Products\CreditAccount.cs" Link="Mod\CreditAccount.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Products\Ladder.cs" Link="Mod\Ladder.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Products\LoanHolds.cs" Link="Mod\LoanHolds.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Debt\Shark.cs" Link="Mod\Shark.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Debt\Relief.cs" Link="Mod\Relief.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Ventures\VenturesCatalogue.cs" Link="Mod\VenturesCatalogue.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Ventures\VenturesModel.cs" Link="Mod\VenturesModel.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Ventures\Cast.cs" Link="Mod\Cast.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Ventures\Deals.cs" Link="Mod\Deals.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Ventures\Pitch.cs" Link="Mod\Pitch.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Ventures\Market.cs" Link="Mod\Market.cs" />
