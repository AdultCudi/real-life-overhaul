<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the economy's game-free parts outside the game: the credit rating's arithmetic, the lending terms and the
       phone's fee, the credit file's cap and folding, its line in the save across versions, and how the game's loans
       are told apart. Compiles the mod's own files, so it checks exactly what ships.
       Run: dotnet run -c Release (from this folder). Exit code 0 = all checks passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RealLifeOverhaul</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\CreditCatalogue.cs" Link="Mod\CreditCatalogue.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\CreditModel.cs" Link="Mod\CreditModel.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\CreditScoring.cs" Link="Mod\CreditScoring.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\CreditStore.cs" Link="Mod\CreditStore.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\CreditLedger.cs" Link="Mod\CreditLedger.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Credit\LoanBook.cs" Link="Mod\LoanBook.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Economy\Lending\LendingTerms.cs" Link="Mod\LendingTerms.cs" />
  </ItemGroup>

</Project>
