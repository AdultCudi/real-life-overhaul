<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the Planner's game-free parts outside the game: the entry model, order, clashes, the game's calendar,
       reminders across saves and time skips, and what a damaged save does. Compiles the mod's own two files, so it
       checks exactly what ships. Run: dotnet run -c Release (from this folder). Exit code 0 = all checks passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RealLifeOverhaul</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Planner\PlannerModel.cs" Link="Mod\PlannerModel.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Planner\PlannerStore.cs" Link="Mod\PlannerStore.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Core\SaveLines.cs" Link="Mod\SaveLines.cs" />
  </ItemGroup>

</Project>
