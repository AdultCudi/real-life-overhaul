<Project Sdk="Microsoft.NET.Sdk">

  <!-- Checks the Planner's game-free parts outside the game: the entry model, order, clashes (overlaps and ways too long),
       the game's calendar, reminders across saves and time skips, when to leave, the player's own entries that repeat,
       the filter's groups, the Week tab's columns, the day's free time and money, the texts in the three languages, and
       what a damaged or an old save does. Compiles the mod's own three files, so it checks exactly what ships. Run: dotnet run -c Release (from this folder). Exit code 0 = all checks passed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <RootNamespace>RealLifeOverhaul</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Planner\PlannerModel.cs" Link="Mod\PlannerModel.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Planner\PlannerStore.cs" Link="Mod\PlannerStore.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Planner\PlannerRules.cs" Link="Mod\PlannerRules.cs" />
    <Compile Include="..\..\Assets\Mods\RealLifeOverhaul\Scripts\Core\SaveLines.cs" Link="Mod\SaveLines.cs" />
  </ItemGroup>

</Project>
